{
  "name": "@repo/error",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Error handling utilities with Sentry integration and error catalog registry",
  "license": "PROPRIETARY",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "checktypes": "tsc --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs"
  },
  "peerDependencies": {
    "@repo/utils": "workspace:*",
    "@sentry/node": "*",
    "@sentry/nextjs": "*",
    "react": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.0.9",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
