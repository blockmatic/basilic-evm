{
  "name": "@repo/react",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "checktypes": "tsgo --noEmit",
    "dev": "tsup --watch",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:biome": "biome check .",
    "lint:biome:fix": "biome check . --write",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:biome:fix",
    "prepack": "pnpm build && node ../../scripts/prepare-publish.mjs",
    "postpack": "node ../../scripts/restore-publish.mjs",
    "test": "echo \"no test\""
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/ui": "workspace:*",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "@types/react": "*",
    "eslint": "*",
    "tsup": "*",
    "@typescript/native-preview": "*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.17",
    "react": "^19.0.0"
  }
}
