OPENAI_API_KEY=sk-proj-1234567890

# Database configuration
# Set PGLITE=true to use in-memory PGLite database (useful for preview branches, local dev without PostgreSQL)
# When PGLITE=true, DATABASE_URL is optional and defaults to PGLite URL
# When PGLITE=false, DATABASE_URL is required
PGLITE=false
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=App
# Set USE_FAKE_EMAIL=true to use fake email provider (emails won't be sent, stored in memory for testing)
USE_FAKE_EMAIL=false

# Auth configuration
# BETTER_AUTH_URL: Public-facing URL where auth endpoints are accessible (defaults to http://localhost:3000 for local dev)
# For local development, this should be the Next.js frontend URL (port 3000), not the Fastify backend URL (port 3001)
# because auth endpoints are proxied through Next.js. This ensures cookies are set for the correct domain.
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS: Comma-separated list of trusted origins (defaults to http://localhost:3000,http://localhost:3001 for local dev)
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001