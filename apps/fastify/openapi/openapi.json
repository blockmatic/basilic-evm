    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Returns server health status with current ISO datetime",
        "tags": ["health"],
        "description": "Health check endpoint",
        "security": [],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok", "initialized", "now"],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "initialized": {
                      "type": "boolean"
                    },
                    "now": {
                      "format": "date-time",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
